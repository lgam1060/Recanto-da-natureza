<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Recanto_da_natureza.Controls"
    x:Class="Recanto_da_natureza.MainPage"
    BackgroundColor="#E8DCCB"
    Title="Recanto da Natureza">

    <ScrollView>

        <VerticalStackLayout
            Padding="0"
            Spacing="0">

            <!-- NAVBAR -->
            <controls:NavBarView />

            <!-- IMAGEM PRINCIPAL -->
            <Grid HeightRequest="320">

                <Image
                    Source="panorama.jpg"
                    Aspect="AspectFill"/>

                <!-- ESCURECER LEVEMENTE -->
                <BoxView
                    BackgroundColor="#55000000"/>

                <!-- TEXTO SOBRE A IMAGEM -->
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="8">

                    <Label
                        Text="Recanto da Natureza"
                        FontSize="40"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource LabelOnDark}"/>

                    <Label
                        Text="Pousada exclusiva em Brotas/SP"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource LabelOnDark}"/>

                </VerticalStackLayout>

            </Grid>

            <!-- CONTEÚDO -->
            <VerticalStackLayout
                Padding="20"
                Spacing="20">

                <!-- WEATHER CARD -->
                <Border
                    BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle 20"
                    Padding="16"
                    Margin="0, -40, 0, 0">

                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <VerticalStackLayout>
                            <Label x:Name="LocationLabel" Text="Brotas, SP" FontAttributes="Bold" FontSize="16" Style="{StaticResource LabelOnLight}" />
                            <Label x:Name="WeatherUpdatedLabel" Text="Atualizando..." FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>

                        <VerticalStackLayout HorizontalOptions="EndAndExpand" Spacing="2">
                            <Label x:Name="TemperatureLabel" Text="--°C" FontSize="28" FontAttributes="Bold" Style="{StaticResource LabelOnLight}" HorizontalOptions="End" />
                            <Label x:Name="ConditionLabel" Text="--" FontSize="14" Style="{StaticResource LabelOnLight}" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                </Border>

                <!-- CARD PRINCIPAL -->
                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 30"
                    Padding="25">

                    <VerticalStackLayout Spacing="22">

                        <Label
                            Text="Informações da Pousada"
                            FontSize="28"
                            FontAttributes="Bold"
                            Style="{StaticResource LabelOnLight}"
                            HorizontalOptions="Center"/>

                        <!-- ITEM -->
                        <HorizontalStackLayout Spacing="15">

                            <Label
                                Text="🌿"
                                FontSize="28"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout>

                                <Label
                                    Text="8 Chalés Exclusivos"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    Style="{StaticResource LabelOnLight}"/>

                                <Label
                                    Text="Ambientes privativos em meio à natureza."
                                    FontSize="15"
                                    TextColor="Gray"/>

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                        <!-- ITEM -->
                        <HorizontalStackLayout Spacing="15">

                            <Label
                                Text="👫"
                                FontSize="28"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout>

                                <Label
                                    Text="Máximo de 2 hóspedes"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    Style="{StaticResource LabelOnLight}"/>

                                <Label
                                    Text="Ideal para casais e momentos tranquilos."
                                    FontSize="15"
                                    TextColor="Gray"/>

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                        <!-- ITEM -->
                        <HorizontalStackLayout Spacing="15">

                            <Label
                                Text="🔞"
                                FontSize="28"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout>

                                <Label
                                    Text="Ambiente adulto"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    Style="{StaticResource LabelOnLight}"/>

                                <Label
                                    Text="Permitido apenas maiores de 14 anos."
                                    FontSize="15"
                                    TextColor="Gray"/>

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                        <!-- ITEM -->
                        <HorizontalStackLayout Spacing="15">

                            <Label
                                Text="🚫"
                                FontSize="28"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout>

                                <Label
                                    Text="Pets não permitidos"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    Style="{StaticResource LabelOnLight}"/>

                                <Label
                                    Text="Mantemos um ambiente silencioso e reservado."
                                    FontSize="15"
                                    TextColor="Gray"/>

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <!-- BOTÕES -->
                <Button
                    Text="Login e Cadastro"
                    HeightRequest="60"
                    FontSize="20"
                    CornerRadius="12"
                    BackgroundColor="#4D6B50"
                    TextColor="White"
                    Clicked="AbrirLogin"/>

                <Button
                    Text="Reservas"
                    HeightRequest="60"
                    FontSize="20"
                    CornerRadius="12"
                    BackgroundColor="#7FB77E"
                    TextColor="White"
                    Clicked="AbrirReserva"/>

                <Button
                    Text="Sobre Nós"
                    HeightRequest="60"
                    FontSize="20"
                    CornerRadius="12"
                    BackgroundColor="Transparent"
                    BorderColor="#4D6B50"
                    BorderWidth="1"
                    TextColor="#4D6B50"
                    Clicked="AbrirSobre"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>