<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Recanto_da_natureza.Controls"
             x:Class="Recanto_da_natureza.ConfirmarReservaPage"
             BackgroundColor="#E8DCCB"
             Title="Confirmar Reserva">

    <ScrollView> 
        <VerticalStackLayout Padding="20" Spacing="20">

            <controls:NavBarView />

            <Label x:Name="ChaleTitle" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource VerdeEscuro}" />

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="StartAndExpand">
                <Label Text="Tema escuro" VerticalOptions="Center" Style="{StaticResource LabelOnLight}" />
                <Switch x:Name="ThemeSwitch" Toggled="OnThemeToggled" />
            </HorizontalStackLayout>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Text="Check-in:" Grid.Column="0" VerticalOptions="Center" Style="{StaticResource LabelOnLight}" />
                <DatePicker x:Name="CheckInDate" Grid.Column="1" />

                <Label Text="Check-out:" Grid.Column="2" VerticalOptions="Center" Style="{StaticResource LabelOnLight}" />
                <DatePicker x:Name="CheckOutDate" Grid.Column="3" />
            </Grid>

            <Label x:Name="NightsLabel" Text="Quantidade de diárias: 0" FontSize="16" Style="{StaticResource LabelOnLight}" />

            <Label x:Name="PricePerNightLabel" Text="Valor por noite: R$ 0,00" FontSize="16" Style="{StaticResource LabelOnLight}" />

            <Label x:Name="TotalLabel" Text="Valor total: R$ 0,00" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource VerdeEscuro}" />

            <HorizontalStackLayout Spacing="10">
                <Entry x:Name="CouponEntry" Placeholder="Código do cupom" HorizontalOptions="FillAndExpand" />
                <Button Text="Aplicar" Clicked="OnAplicarCupomClicked" />
            </HorizontalStackLayout>

            <Label x:Name="DiscountLabel" Text="Desconto: R$ 0,00 (0%)" FontSize="14" Style="{StaticResource LabelOnLight}" />

            <Label Text="Forma de pagamento:" Style="{StaticResource LabelOnLight}" />
            <Picker x:Name="PaymentPicker" TextColor="#000000" BackgroundColor="#FFFFFF">
                <Picker.Items>
                    <x:String>Cartão</x:String>
                    <x:String>Pix</x:String>
                    <x:String>Dinheiro</x:String>
                </Picker.Items>
            </Picker>

            <Button x:Name="ConfirmButton" Text="Confirmar" HeightRequest="60" FontSize="20" Clicked="OnConfirmarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
