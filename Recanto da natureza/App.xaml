<?xml version="1.0" encoding="utf-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Recanto_da_natureza.App">

    <Application.Resources>

        <Color x:Key="VerdePrincipal">#7BAE7F</Color>
        <Color x:Key="VerdeEscuro">#4D6B50</Color>
        <Color x:Key="Bege">#E8DCCB</Color>
        <Color x:Key="Branco">#FFFFFF</Color>

        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource VerdePrincipal}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HeightRequest" Value="55"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="PlaceholderColor" Value="Gray"/>
            <Setter Property="HeightRequest" Value="50"/>
        </Style>

    </Application.Resources>

</Application>