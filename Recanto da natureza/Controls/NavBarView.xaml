<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recanto_da_natureza.Controls.NavBarView"
             BackgroundColor="Transparent"
             Padding="12">

    <Frame BackgroundColor="White" CornerRadius="12" HasShadow="True" Padding="8" HorizontalOptions="FillAndExpand">
        <HorizontalStackLayout Spacing="12" HorizontalOptions="FillAndExpand">

            <Button x:Name="HomeButton" Text="Início" BackgroundColor="Transparent" TextColor="{StaticResource TextoEscuro}" Clicked="OnHomeClicked" />
            <Button x:Name="ReservasButton" Text="Reservas" BackgroundColor="Transparent" TextColor="{StaticResource TextoEscuro}" Clicked="OnReservasClicked" />
            <Button x:Name="SobreButton" Text="Sobre" BackgroundColor="Transparent" TextColor="{StaticResource TextoEscuro}" Clicked="OnSobreClicked" />
            <Button x:Name="LoginButton" Text="Login" BackgroundColor="Transparent" TextColor="{StaticResource TextoEscuro}" Clicked="OnLoginClicked" />

        </HorizontalStackLayout>
    </Frame>

</ContentView>