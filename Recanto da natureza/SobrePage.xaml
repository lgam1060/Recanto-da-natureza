<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Recanto_da_natureza.SobrePage"
    BackgroundColor="#E8DCCB"
    Title="Sobre Nós">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Image
                Source="natureza.jpg"
                HeightRequest="260"
                Aspect="AspectFill"/>

            <Label
                Text="Sobre Nós"
                FontSize="34"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#4D6B50"/>

            <Border
                BackgroundColor="White"
                StrokeShape="RoundRectangle 25"
                Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="O Recanto da Natureza é uma pousada localizada em Brotas/SP voltada para descanso, conforto e tranquilidade."
                        FontSize="18"/>

                    <Label
                        Text="Contamos com 8 chalés exclusivos para até 2 hóspedes."
                        FontSize="18"/>

                    <Label
                        Text="Nosso ambiente é reservado apenas para adultos e jovens acima de 14 anos."
                        FontSize="18"/>

                    <Label
                        Text="Para manter a tranquilidade da pousada, não permitimos pets."
                        FontSize="18"/>

                </VerticalStackLayout>

            </Border>

            <Border
                BackgroundColor="White"
                StrokeShape="RoundRectangle 25"
                Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Chalés Disponíveis"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#4D6B50"/>

                    <Label
                        Text="Chalé Sky — Vista panorâmica moderna"
                        FontSize="18"/>

                    <Label
                        Text="Chalé Wood — Estilo rústico aconchegante"
                        FontSize="18"/>

                    <Label
                        Text="Chalé Stone — Design sofisticado natural"
                        FontSize="18"/>

                </VerticalStackLayout>

            </Border>

            <Button Text="Contato via WhatsApp"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>